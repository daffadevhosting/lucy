# ====================== Lucy Voice Assistant ======================
# Copy this file to .env and fill in your values

# --- Porcupine Wake Word ---
PORCUPINE_ACCESS_KEY=your_picovoice_access_key_here

# Custom wake word model (recommended for "Hey Lucy")
# Train at https://console.picovoice.ai/ → download .ppn for raspberry-pi
# Then place it under models/wakewords/
PORCUPINE_KEYWORD_PATH=models/wakewords/hey_lucy_raspberry-pi.ppn

# Fallback built-in keyword if PORCUPINE_KEYWORD_PATH is empty
# Available: porcupine, jarvis, computer, alexa, hey google, etc.
PORCUPINE_KEYWORD=porcupine

# Sensitivity 0.0 – 1.0 (higher = more sensitive, more false positives)
PORCUPINE_SENSITIVITY=0.65

# --- LLM Provider ---
# Grok (xAI) recommended
LLM_API_KEY=your_xai_or_openai_api_key
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-2-latest

# OpenAI alternative:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- STT ---
# Engine: api | whispercpp | faster-whisper
STT_ENGINE=api

# Cloud (only needed when STT_ENGINE=api)
STT_API_KEY=your_openai_whisper_key
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# Local model (whispercpp / faster-whisper)
STT_LOCAL_MODEL=models/whisper/ggml-tiny.bin
STT_N_THREADS=4
STT_LANGUAGE=id

# --- MQTT ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=lucy-edge-01

# --- TTS Engine ---
# Options: piper | elevenlabs | espeak
TTS_ENGINE=piper

# Piper (offline)
PIPER_MODEL_PATH=models/id_ID-media-medium.onnx
PIPER_CONFIG_PATH=models/id_ID-media-medium.onnx.json

# ElevenLabs (online)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Audio ---
SAMPLE_RATE=16000
RECORD_SECONDS=4.5
CHANNELS=1

# --- Home Assistant ---
HA_DISCOVERY=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/lucy.log
